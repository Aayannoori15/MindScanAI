# MindScan AI — copy to .env and adjust

APP_NAME=MindScan AI
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Use sqlite for local demo; postgres in Docker
DATABASE_URL=sqlite:///./mindscan.db
# DATABASE_URL=postgresql://mindscan:mindscan@postgres:5432/mindscan

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model directory (teammate drops .pt files here)
MODEL_DIR=backend/models
USE_MOCK_INFERENCE=true

CRISIS_STRESS_THRESHOLD=30
CRISIS_SEVERITY_LABEL=Severe_Stress
