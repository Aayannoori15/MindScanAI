# MindScan AI — copy to .env and adjust

APP_NAME=MindScan AI
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Use sqlite for local demo; postgres in Docker
DATABASE_URL=sqlite:///./mindscan.db
# DATABASE_URL=postgresql://mindscan:mindscan@postgres:5432/mindscan

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model directory (teammate drops .pt files here)
MODEL_DIR=backend/models
USE_MOCK_INFERENCE=true

CRISIS_STRESS_THRESHOLD=30
CRISIS_SEVERITY_LABEL=Severe_Stress

# Groq — speech-to-text (Whisper) and LLM report generation.
# Get keys at https://console.groq.com. Leave ENABLE_GROQ=false to run without them.
GROQ_STT_API_KEY=
GROQ_LLM_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
ENABLE_GROQ=false
